@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix brick:  <https://brickschema.org/schema/Brick#> .
@prefix uva:    <https://uva.edu/schema#> .
@prefix olsson: <https://example.com/olsson#> .

############################################################
# Rooms
############################################################

olsson:R1 a brick:Room ;
    rdfs:label "Room 1" .

olsson:R2 a brick:Room ;
    rdfs:label "Room 2" .

############################################################
# Pipe segments: top and bottom branches
# (each is a uva:PipeSegment, located in a room, in EmergencySprinkler domain)
############################################################

olsson:Top_R1 a uva:PipeSegment ;
    rdfs:label "Top Pipe in Room 1" ;
    brick:hasLocation olsson:R1 ;
    uva:hasDomain uva:EmergencySprinkler .

olsson:Top_R2 a uva:PipeSegment ;
    rdfs:label "Top Pipe in Room 2" ;
    brick:hasLocation olsson:R2 ;
    uva:hasDomain uva:EmergencySprinkler .

olsson:Bottom_R1 a uva:PipeSegment ;
    rdfs:label "Bottom Pipe in Room 1" ;
    brick:hasLocation olsson:R1 ;
    uva:hasDomain uva:EmergencySprinkler .

olsson:Bottom_R2 a uva:PipeSegment ;
    rdfs:label "Bottom Pipe in Room 2" ;
    brick:hasLocation olsson:R2 ;
    uva:hasDomain uva:EmergencySprinkler .

############################################################
# Valves A and B (isolation valves upstream of each branch)
############################################################
olsson:MainValve a brick:Valve ;
    rdfs:label "Main Valve" ;
    brick:hasLocation olsson:R1 ;
    uva:hasDomain uva:EmergencySprinkler .

olsson:ValveA a brick:Valve ;
    rdfs:label "Valve A" ;
    brick:hasLocation olsson:R1 ;
    uva:hasDomain uva:EmergencySprinkler .

olsson:ValveB a brick:Valve ;
    rdfs:label "Valve B" ;
    brick:hasLocation olsson:R1 ;
    uva:hasDomain uva:EmergencySprinkler .

############################################################
# Fixtures at the end of each branch (optional)
############################################################

olsson:FixtureA a brick:Valve ;
    rdfs:label "Fixture A" ;
    brick:hasLocation olsson:R2 ;
    uva:hasDomain uva:EmergencySprinkler .

olsson:FixtureB a brick:Valve ;
    rdfs:label "Fixture B" ;
    brick:hasLocation olsson:R2 ;
    uva:hasDomain uva:EmergencySprinkler .

############################################################
# Topology via brick:feeds
# Top branch:  ValveA -> Top_R1 -> Top_R2 -> FixtureA
# Bottom branch: Bottom_R1 -> Bottom_R2 ->V Valve B --> FixtureB
############################################################

olsson:MainValve    brick:feeds olsson:ValveA.
olsson:ValveA    brick:feeds olsson:Top_R1 .
olsson:Top_R1    brick:feeds olsson:Top_R2 .
olsson:Top_R2    brick:feeds olsson:FixtureA .

olsson:MainValve    brick:feeds olsson:Bottom_R1 .
olsson:Bottom_R1 brick:feeds olsson:Bottom_R2 .
olsson:Bottom_R2 brick:feeds olsson:ValveB .
olsson:ValveB brick:feeds olsson:FixtureB .
